# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Set to True only on your own computer. Use False on a real server.
DJANGO_DEBUG=True
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed on a real server with HTTPS, e.g. https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Email (used to send replies to contact messages). Example for Gmail:
# turn on 2-step verification, then create an "App password" in your Google account.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-address@gmail.com
# For local testing without sending real mail, uncomment (replies are printed in the terminal, not delivered):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
